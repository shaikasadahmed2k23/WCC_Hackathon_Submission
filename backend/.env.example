# Copy to .env if you want to change defaults. Nothing here is required for the demo.
# Optional: turn on language-model extraction (any OpenAI-compatible endpoint; Groq shown).
# The verifier still checks every quote, so a model cannot add unsupported claims.
# GROQ_API_KEY=your_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# EXTRACTOR=auto            # rules | llm | auto
# GITHUB_TOKEN=             # raises GitHub API rate limits for repo import
# DEMO_MODE=1               # set 0 to hide the demo account list on the login page
# RESEED_ON_START=0         # set 1 to reset the demo database on every start
